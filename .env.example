ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Off by default on purpose. This is not a secret — it's a plain on/off
# switch for the internal /api/dev/transcribe accuracy-harness endpoint,
# which spends real AssemblyAI credits per call. Set to "true" only while
# you're actively running the harness at /dev/accuracy-test, then unset it.
ENABLE_DEV_HARNESS=false
